{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/", "destination": "/v3.html"},
    {"source": "/website", "destination": "/v3.html"}
  ],
  "headers": [
    {"source": "/admin", "headers": [{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source": "/(.*)", "headers": [{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ]
}